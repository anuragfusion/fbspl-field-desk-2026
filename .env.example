# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the pooled (port 6543, pgbouncer) string for the running app, the direct
# one (port 5432) if you ever need a migration/session-mode connection.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Document storage (Supabase Storage — private bucket, auto-created on startup).
# SUPABASE_URL is just https://<project-ref>.supabase.co.
# SUPABASE_SERVICE_ROLE_KEY: dashboard -> Project Settings -> API -> service_role
# secret key. NOT the anon/public key — this one bypasses Storage RLS and must
# never be sent to a browser. Server-side env var only.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=documents

# Optional: auto-seed an admin user and event on first startup (see app/main.py).
ADMIN_USERNAME=
ADMIN_PASSWORD=
EVENT_NAME=
EVENT_VENUE=
EVENT_CITY=
EVENT_COUNTRY=
EVENT_STARTS=
EVENT_ENDS=
EVENT_TIMEZONE=UTC
