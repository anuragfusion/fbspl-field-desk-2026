# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the pooled (port 6543, pgbouncer) string for the running app, the direct
# one (port 5432) if you ever need a migration/session-mode connection.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Document storage (Supabase Storage — private bucket, auto-created on startup).
# SUPABASE_URL is just https://<project-ref>.supabase.co.
# SUPABASE_SERVICE_ROLE_KEY: dashboard -> Project Settings -> API -> service_role
# secret key. NOT the anon/public key — this one bypasses Storage RLS and must
# never be sent to a browser. Server-side env var only.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=documents

# Image leads (photos of a card). Own private bucket, auto-created on startup.
# Invalid values are ignored with a warning in the log and the default is used.
SUPABASE_IMAGES_BUCKET=images
# Longest side after resizing on the phone, 640-4096.
IMAGE_MAX_DIMENSION=1600
# 0.3-1.0.
IMAGE_JPEG_QUALITY=0.8
# Per photo, 102400-20971520.
IMAGE_MAX_UPLOAD_BYTES=5242880
# info | debug | off.
IMAGE_LOG_LEVEL=info
# on | off — the phone's browser console.
IMAGE_CONSOLE_LOG=on
# Optional: base for photo links in the image-leads CSV, when a proxy hides https.
PUBLIC_BASE_URL=

# Optional: auto-seed an admin user and event on first startup (see app/main.py).
ADMIN_USERNAME=
ADMIN_PASSWORD=
EVENT_NAME=
EVENT_VENUE=
EVENT_CITY=
EVENT_COUNTRY=
EVENT_STARTS=
EVENT_ENDS=
EVENT_TIMEZONE=UTC
